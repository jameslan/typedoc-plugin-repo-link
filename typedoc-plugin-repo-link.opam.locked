opam-version: "2.0"
name: "typedoc-plugin-repo-link"
version: "0.0.1"
maintainer: "jameslan@gmail.com"
authors: "James Lan"
homepage: "https://github.com/jameslan/typedoc-plugin-repo-link"
bug-reports: "https://github.com/jameslan/typedoc-plugin-repo-link/issues"
depends: [
  "astring" {= "0.8.5" & with-dev-setup}
  "base" {= "v0.17.1" & with-dev-setup}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base" & with-dev-setup}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "camlp-streams" {= "5.0.1" & with-dev-setup}
  "chrome-trace" {= "3.17.2" & with-dev-setup}
  "cmdliner" {= "1.3.0"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2" & with-dev-setup}
  "dune" {= "3.17.2"}
  "dune-build-info" {= "3.17.2"}
  "dune-configurator" {= "3.17.2" & with-dev-setup}
  "dune-rpc" {= "3.17.2" & with-dev-setup}
  "dyn" {= "3.17.2" & with-dev-setup}
  "either" {= "1.0.0" & with-dev-setup}
  "fiber" {= "3.7.0" & with-dev-setup}
  "fix" {= "20230505" & with-dev-setup}
  "fpath" {= "0.7.3" & with-dev-setup}
  "jsonrpc" {= "1.22.0" & with-dev-setup}
  "lsp" {= "1.22.0" & with-dev-setup}
  "melange" {= "5.1.0-53"}
  "menhir" {= "20240715"}
  "menhirCST" {= "20240715"}
  "menhirLib" {= "20240715"}
  "menhirSdk" {= "20240715"}
  "merlin-lib" {= "5.4.1-503" & with-dev-setup}
  "ocaml" {= "5.3.0"}
  "ocaml-base-compiler" {= "5.3.0"}
  "ocaml-compiler" {= "5.3.0"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-config" {= "3"}
  "ocaml-index" {= "5.4.1-503" & with-dev-setup}
  "ocaml-lsp-server" {= "1.22.0" & with-dev-setup}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-version" {= "4.0.0" & with-dev-setup}
  "ocaml_intrinsics_kernel" {= "v0.17.1" & with-dev-setup}
  "ocamlbuild" {= "0.16.1" & with-dev-setup}
  "ocamlc-loc" {= "3.17.2" & with-dev-setup}
  "ocamlfind" {= "1.9.8" & with-dev-setup}
  "ocamlformat" {= "0.27.0" & with-dev-setup}
  "ocamlformat-lib" {= "0.27.0" & with-dev-setup}
  "ocamlformat-rpc-lib" {= "0.27.0" & with-dev-setup}
  "ocp-indent" {= "1.8.1" & with-dev-setup}
  "ordering" {= "3.17.2" & with-dev-setup}
  "pp" {= "2.0.0" & with-dev-setup}
  "ppx_derivers" {= "1.2.1"}
  "ppx_yojson_conv_lib" {= "v0.17.0" & with-dev-setup}
  "ppxlib" {= "0.35.0"}
  "re" {= "1.12.0" & with-dev-setup}
  "seq" {= "base" & with-dev-setup}
  "sexplib0" {= "v0.17.0"}
  "spawn" {= "v0.17.0" & with-dev-setup}
  "stdio" {= "v0.17.0" & with-dev-setup}
  "stdlib-shims" {= "0.3.0"}
  "stdune" {= "3.17.2" & with-dev-setup}
  "topkg" {= "1.0.8" & with-dev-setup}
  "uucp" {= "16.0.0" & with-dev-setup}
  "uuseg" {= "16.0.0" & with-dev-setup}
  "uutf" {= "1.0.4" & with-dev-setup}
  "xdg" {= "3.17.2" & with-dev-setup}
  "yojson" {= "2.2.2" & with-dev-setup}
]
build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
]
dev-repo: "ssh://git@github.com/jameslan/typedoc-plugin-repo-link.git"
